# Copy to keystore.properties (same folder as package.json) and fill in. NEVER commit or share the real file.
# Make the upload key once:  keytool -genkeypair -v -keystore shotleft-upload.jks -alias upload -keyalg RSA -keysize 2048 -validity 10000
# Back up the .jks file AND these passwords in two safe places. Play App Signing keeps the app's real signing key.
storeFile=../../shotleft-upload.jks
storePassword=
keyAlias=upload
keyPassword=
